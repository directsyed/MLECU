# MLECU — llama-server for the curation judge (dense Qwen3.6-27B Q8, dual-GPU, MTP).
#
# Promoted from tmux-on-demand to systemd (2026-07-05): multi-day reference-tier judging needs
# a server that survives SSH drops, closed terminals, and reboots. Clock locks are applied by
# gpu-powerlimit.service first (After=), so inference always runs on the certified stable config.
#
# Deploy:  sudo cp infrastructure/server/llama-judge.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now llama-judge.service
# Verify:  curl -s http://127.0.0.1:8080/v1/models | head -c 200
# Swap models: edit ExecStart, daemon-reload, restart (config.yaml llm.model tag must match!).
[Unit]
Description=MLECU curation judge llama-server (dense 27B Q8, certified 2026-07-05)
After=network.target gpu-powerlimit.service
Wants=gpu-powerlimit.service

[Service]
Type=simple
User=syed
ExecStart=/home/syed/tools/llama.cpp/build/bin/llama-server \
  -m "/home/syed/Shared/Computing Projects/MLECU/ml/curation/data/models/Qwen3.6-27B-Q8_0.gguf" \
  -ngl 999 --split-mode layer --tensor-split 1,1 \
  -c 16384 -np 1 \
  --spec-type draft-mtp --host 127.0.0.1 --port 8080 --jinja
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
