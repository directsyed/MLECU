[Unit]
Description=MLECU corpus pipeline, daily ingestion pass

[Timer]
# DAILY at 04:30 (+ up to 15 min jitter). Rationale: the git sources (defs/theory) change
# over weeks, forum threads accrue slowly, and a daily bounded browser crawl is gentle on
# legacygt's WAF. Enough to passively accumulate while the 2nd GPU is being set up.
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=900
# run a missed pass if the box was off at the scheduled time (comment must be on its own
# line: systemd does NOT support inline comments - an inline one voids the whole setting)
Persistent=true
Unit=mlecu-corpus.service

[Install]
WantedBy=timers.target
